@using System.Linq

<div class="cw-weights-grid">
    @foreach (var kv in Data.SpawnWeights.OrderBy(kv => kv.Key))
    {
        <div class="cw-weight-row" title="@(SettingsRulesData.CellDescriptions.GetValueOrDefault(kv.Key, ""))">
            <div class="cw-sprite-wrap">
                <img class="cw-cell-sprite" src="Assets/Sprites/Cell_@(kv.Key).jpg?v=3" alt="@kv.Key" />
                <img class="cw-sprite-zoom-popup" src="Assets/Sprites/Cell_@(kv.Key).jpg?v=3" alt="" />
            </div>
            <span class="cw-weight-name">@kv.Key</span>
            <input type="number" min="0" max="100"
                   value="@kv.Value"
                   @onchange="@(e => OnWeightChange(kv.Key, e))" />
        </div>
    }
    <div class="cw-weight-row cw-weight-row-empty"
         title="Cells that start empty (not populated). Calculated as grid size minus initial population — not a spawn weight.">
        <div class="cw-weight-empty-swatch"></div>
        <span class="cw-weight-name">Empty</span>
        <span class="cw-weight-readonly">@(Data.StartCols * Data.StartRows - Data.PopCount)</span>
    </div>
</div>

@code {
    [CascadingParameter] public SettingsData Data { get; set; } = null!;

    private void OnWeightChange(string typeName, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            Data.SpawnWeights[typeName] = v;
    }
}
