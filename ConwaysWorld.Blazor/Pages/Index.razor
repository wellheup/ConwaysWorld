        _animationEnabled = true;
        _minNeighbors     = 2;
        _maxNeighbors     = 3;
        _birthNeighbors   = 3;
        _famineEnabled    = true;
        _famineCooldown   = 15;
        _famineDuration   = 10;
        _floodEnabled       = true;
        _randomLifeEnabled            = false;
        _randomLifeThresholdPct       = 5.0;
        _randomLifeThresholdPctStr    = "5.0";
        _randomLifeThresholdCount     = (int)Math.Round(5.0 / 100.0 * _startCols * _startRows);
        _autoContinue                 = false;
