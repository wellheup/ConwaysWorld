<div class="cw-modal-overlay" @onclick="OnClose">
    <div class="cw-modal" @onclick:stopPropagation>
        <div class="cw-modal-header">
            <span>Settings</span>
            <button class="cw-modal-close" @onclick="OnClose">✕</button>
        </div>
        <div class="cw-modal-tabs">
            <button class="cw-modal-tab @(_activeTab == 0 ? "cw-modal-tab-active" : "")"
                    @onclick="() => _activeTab = 0">General</button>
            <button class="cw-modal-tab @(_activeTab == 1 ? "cw-modal-tab-active" : "")"
                    @onclick="() => _activeTab = 1">Spawn Weights</button>
            <button class="cw-modal-tab @(_activeTab == 2 ? "cw-modal-tab-active" : "")"
                    @onclick="() => _activeTab = 2">Hotkeys</button>
            <button class="cw-modal-tab @(_activeTab == 3 ? "cw-modal-tab-active" : "")"
                    @onclick="() => _activeTab = 3">Rules</button>
        </div>
        <div class="cw-settings-scroll">
            <CascadingValue Value="Data" IsFixed="false">
                @if (_activeTab == 0)
                {
                    <SettingsTabGeneral />
                }
                else if (_activeTab == 1)
                {
                    <SettingsTabSpawnWeights />
                }
                else if (_activeTab == 2)
                {
                    <SettingsTabHotkeys />
                }
                else if (_activeTab == 3)
                {
                    <SettingsTabRules />
                }
            </CascadingValue>
        </div>
        @if (_activeTab != 3)
        {
            <div class="cw-modal-footer">
                <button class="cw-apply-btn" style="flex:1" @onclick="OnApplyAndRestart">Apply &amp; Restart</button>
                <button class="cw-apply-btn" style="flex:1;background:#555" @onclick="OnResetToDefaults">Reset Defaults</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public SettingsData Data { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnApplyAndRestart { get; set; }
    [Parameter] public EventCallback OnResetToDefaults { get; set; }
    [Parameter] public int ActiveTab { get; set; }
    [Parameter] public EventCallback<int> ActiveTabChanged { get; set; }

    private int _activeTab
    {
        get => ActiveTab;
        set => ActiveTabChanged.InvokeAsync(value);
    }
}
